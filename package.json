{
  "name": "@agentmail/agentid-better-auth",
  "version": "0.1.1",
  "description": "AgentID provider helper for Better Auth's Generic OAuth plugin",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "better-auth": ">=1.7.2 <2"
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "better-auth": "1.7.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.4.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentmail-to/agentid-better-auth.git"
  },
  "homepage": "https://www.agentid.com/docs/better-auth",
  "bugs": {
    "url": "https://github.com/agentmail-to/agentid-better-auth/issues"
  },
  "keywords": [
    "agentid",
    "agentmail",
    "better-auth",
    "oauth",
    "oidc",
    "authentication",
    "ai-agents"
  ]
}
